#include<stdio.h>
#include<conio.h>
#include<iostream.h>
void main()
{
	int j,i,count;
	clrscr();
	for(i=0;i<=10;i++)
	{
		count=0;
		for(j=2;j<=i/2;j++)
		{
			if(i%j==0)
			{
				count++;
				break;
			}
		}
		if(count>0)
		{
			cout<<"\n number"<<i;
			cout<<"is not prime";
		}
		else
		{
			cout<<"\n number"<<i;
			cout<<"is prime";
		}
	}
	getch();
}
