#include<stdio.h>
#include<conio.h>
#include<iostream.h>

int add(int x, int y);
int add(int x, int y, int z);

void main()
{
    int a, b, c, d;
    clrscr();

    cout << "Enter three numbers: ";
    cin >> a >> b >> c;

    d = add(a, b);
    cout << "\nSum of two arguments = " << d;

    d = add(a, b, c);
    cout << "\nSum of three arguments = " << d;

    getch();
}

int add(int x, int y)
{
    return x + y;
}

int add(int x, int y, int z)
{
    return x + y + z;
}