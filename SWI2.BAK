#include<stdio.h>
#include<iostream.h>
#include<conio.h>
void main()
{
	 float a,b,ans;
	 char sign;
	 clrscr();
	 cout<<"enter your a value=>";
	 cin>>a;
	 cout<<"enter your b value=>";
	 cin>>b;
	 cout<<"enter your sign(+,-,*,/)=>";
	 cin>>sign;
	 switch(sign)
	 {
		case '+':
		{
			ans=a+b;
			cout<<"ans="<<ans;
			break;
		}
		case '-':
		{
			ans=a-b;
			cout<<"ans="<<ans;
			break;
		}
		case '*':
		{
			ans=a*b;
			cout<<"ans="<<ans;
			break;
		}
		case '/':
		{
			ans=a/b;
			cout<<"ans="<<ans;
			break;
		}
		default:
		cout<<"mara kaleja sign to jo";
		break;
	 }
	 getch();
}
